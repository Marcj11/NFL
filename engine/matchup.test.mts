import assert from 'node:assert/strict';
import {simulate,type Unit,type Input} from './matchup.ts';
const u:Unit={qb:.7,ol:.6,receivers:.65,backs:.55,passRush:.62,coverage:.56,runDefense:.58,coachPassRate:.65,coachTempo:.6,coachAggression:.5};
const i:Input={home:{name:'H',unit:u},away:{name:'A',unit:{...u,qb:.45,ol:.48}},context:{windMph:5,rain:false,restHome:7,restAway:6,homeAdvantage:1.5},simulations:2000,seed:21};
const a=simulate(i),b=simulate(i);
assert.deepEqual(a,b,'seeded reproducibility');
assert.equal(a.calibrated,false);
assert.ok(Math.abs(a.homeWin+a.awayWin+a.tie-1)<1e-10);
assert.ok(Math.abs(a.spreadHomeMinus3.win+a.spreadHomeMinus3.push+a.spreadHomeMinus3.lose-1)<1e-10);
assert.ok(a.meanStats.homeReceiverYards<=a.meanStats.homePassYards);
const injury=simulate({...i,home:{...i.home,qbAvailable:false}});
assert.notDeepEqual(a.meanStats.homePassYards,injury.meanStats.homePassYards,'QB changes outcome');
const wind=simulate({...i,context:{...i.context,windMph:35}});
assert.notDeepEqual(a.meanStats.homePassYards,wind.meanStats.homePassYards,'weather affects output');
const defense=simulate({...i,away:{...i.away,unit:{...i.away.unit,coverage:.9}}});
assert.notDeepEqual(a.meanStats.homePassYards,defense.meanStats.homePassYards,'defensive matchup affects output');
const coach=simulate({...i,home:{...i.home,unit:{...i.home.unit,coachPassRate:.1}}});
assert.notDeepEqual(a.meanStats.homePassYards,coach.meanStats.homePassYards,'coach affects output');
assert.throws(()=>simulate({...i,home:{...i.home,unit:{...u,qb:1.5}}}));
console.log('10 assertions passed; PROTOTYPE ONLY; NO CALIBRATED FORECAST.');
